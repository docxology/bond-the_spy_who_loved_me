# Example configuration for a new PROJECT BOND film package.
# Copy to config.yaml and edit the identity fields; manuscript_variables.py
# reads the `paper` section (title/subtitle/version/date) to hydrate tokens.

paper:
  title: "The Spy Who Loved Me: LIPARUS — Special-Agent Mission Software"
  subtitle: "Passive Acoustic Tracking, Liparus-Class Tanker Capture, and Submersible Vehicle Forensics"
  version: "0.1.0"
  date: "2026-08-04"

authors:
  - name: "Daniel Ari Friedman"
    orcid: "0000-0001-6232-9096"
    email: "daniel@activeinference.institute"
    affiliation: "Active Inference Institute"
    corresponding: true

keywords:
  - "passive acoustic detection"
  - "bearing-only target motion analysis"
  - "Liparus-class tanker capture"
  - "submersible vehicle forensics"

metadata:
  license: "MIT"
  language: "en"

mission:
  codename: "LIPARUS"
  film: "The Spy Who Loved Me (1977)"
  phases: ["brief", "recon", "plan", "execute", "debrief"]
  package_version: "0.1.0"
  seed: 11
